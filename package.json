{
    "name": "arrow-cloud-prototype",
    "version": "1.0.0",
    "main": "index.js",
    "scripts": {
        "watch": "node node/build.mjs development --watch",
        "watch:production": "node node/build.mjs production --watch",
        "serve": "browser-sync start --server . --files 'index.html, public/**/*, src/data/**/*.json, dist/**/*'",
        "dev": "npm-run-all --parallel watch watch:datasets serve",
        "dev:prod": "npm-run-all --parallel watch:production serve",
        "build": "node node/build.mjs production",
        "generate:datasets": "node node/generateDatasetManifest.mjs",
        "watch:datasets": "node node/generateDatasetManifest.mjs --watch",
        "predev": "npm run generate:datasets"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "description": "",
    "dependencies": {
        "esbuild": "^0.28.1",
        "three": "^0.184.0"
    },
    "devDependencies": {
        "browser-sync": "^3.0.4",
        "npm-run-all": "^4.1.5"
    }
}
